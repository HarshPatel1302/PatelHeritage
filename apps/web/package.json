{
  "name": "@patel-heritage/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5000",
    "build": "prisma generate && next build",
    "start": "next start -p 5000",
    "lint": "next lint",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "icons": "node scripts/generate-icons.mjs",
    "simulate:rs9n": "tsx scripts/simulate-rs9n.ts",
    "test:e2e": "bash scripts/run-e2e.sh",
    "test": "node --import tsx --test tests/unit.test.ts",
    "typecheck": "tsc --noEmit",
    "test:all": "npm run typecheck && npm run test && npm run test:e2e",
    "test:e2e:against": "bash scripts/e2e-check.sh"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.17",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@vercel/blob": "^2.7.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^10.16.4",
    "jose": "^6.2.8",
    "lucide-react": "^0.294.0",
    "next": "^14.0.0",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.54.0",
    "eslint-config-next": "^14.0.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "tsx": "^4.23.11",
    "typescript": "^5.3.2"
  }
}
