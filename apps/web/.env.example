# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Required ---------------------------------------------------------------
DATABASE_URL="postgresql://user@localhost:5432/patel_heritage?schema=public"

# Signs session and gate-screen cookies. Minimum 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# --- Push notifications -----------------------------------------------------
# Without these, residents only see visitors while the app is open on screen.
# Generate: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@patelheritage.com"

# --- Tunable behaviour ------------------------------------------------------
# How long a flat has to answer before entry is refused by default.
REQUEST_TIMEOUT_SECONDS="60"

# Visitor photos are deleted after this many days (DPDP Act 2023: do not keep
# personal data longer than the purpose requires). Shorten freely; extending it
# needs a reason the committee can defend.
PHOTO_RETENTION_DAYS="30"

# Where photos go in development. Production uses Vercel Blob instead.
PHOTO_STORAGE_DIR="./storage/visitor-photos"

# --- Production only --------------------------------------------------------
# Setting this switches photo storage from local disk to Vercel Blob.
# BLOB_READ_WRITE_TOKEN=""

# Protects /api/cron/sweep so only Vercel's scheduler can trigger the purge.
# CRON_SECRET=""

# --- Development only -------------------------------------------------------
# Unlocks /dev/control-panel and /api/dev/login-as (password-free sign-in).
# The server REFUSES TO START if this is "true" in a production runtime, so an
# insecure deploy fails loudly instead of silently. Leave unset in production.
DEMO_MODE="true"
